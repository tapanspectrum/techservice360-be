<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Verify your email</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
</head>
<body style="margin:0;padding:0;background:#f2f4f6;font-family:Arial,Helvetica,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <!-- container -->
        <table width="600" cellpadding="0" cellspacing="0" role="presentation" style="max-width:600px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 2px 6px rgba(0,0,0,0.08);">
          <!-- header -->
          <tr>
            <td style="padding:24px;text-align:left;background:linear-gradient(90deg,#1a73e8,#1765d6);color:#ffffff;">
              <h1 style="margin:0;font-size:20px;font-weight:600;">Welcome, <%= name %></h1>
            </td>
          </tr>

          <!-- body -->
          <tr>
            <td style="padding:28px 28px 16px 28px;color:#333333;">
              <p style="margin:0 0 16px 0;font-size:15px;line-height:1.5;">
                Hi <strong><%= name %></strong>,
              </p>

              <p style="margin:0 0 20px 0;font-size:15px;line-height:1.5;">
                Thanks for creating an account. To verify your email address, please click the button below:
              </p>

              <div style="text-align:left;margin:24px 0;">
                <!-- Button -->
                <a href="<%= verificationEmailUrl %>" target="_blank" rel="noopener" style="display:inline-block;padding:12px 22px;border-radius:6px;background:#1a73e8;color:#ffffff;text-decoration:none;font-weight:600;font-size:15px;">
                  Verify Email
                </a>
              </div>

              <p style="margin:0 0 12px 0;font-size:14px;color:#666666;line-height:1.5;">
                If the button doesn't work, copy and paste this link into your browser:
              </p>

              <p style="word-break:break-all;margin:0 0 20px 0;font-size:13px;color:#1a73e8;">
                <a href="<%= verificationEmailUrl %>" style="color:#1a73e8;text-decoration:none;" target="_blank" rel="noopener"><%= verificationEmailUrl %></a>
              </p>

              <p style="margin:0;font-size:13px;color:#777777;line-height:1.5;">
                If you did not create an account, simply ignore this email and no action will be taken.
              </p>
            </td>
          </tr>

          <!-- footer -->
          <tr>
            <td style="padding:20px 28px 28px 28px;background:#f7f9fb;color:#8a94a6;font-size:12px;">
              <p style="margin:0 0 6px 0;">Need help? Contact our support at <a href="mailto:support@example.com" style="color:#1a73e8;text-decoration:none;">support@example.com</a></p>
              <p style="margin:6px 0 0 0;">&copy; <span id="year"><%= new Date().getFullYear() %></span> TapanAcharjee — All rights reserved.</p>
            </td>
          </tr>
        </table>

        <!-- small plain footer -->
        <table width="600" cellpadding="0" cellspacing="0" role="presentation" style="max-width:600px;width:100%;margin-top:12px;">
          <tr>
            <td style="text-align:center;font-size:12px;color:#9aa0ae;">
              This email was sent to you because an account was created using this address.
            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>
</body>
</html>
